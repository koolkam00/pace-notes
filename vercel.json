{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "htw-live-study.vercel.app" }],
      "destination": "https://splithappens.run/:path*",
      "permanent": true
    },
    { "source": "/htw", "destination": "/slowdown", "permanent": true },
    { "source": "/packs/smyth_htw", "destination": "/slowdown", "permanent": true },
    { "source": "/tools/marathon-pace", "destination": "/tools/marathon-pace-chart", "permanent": true },
    { "source": "/courses/melbourne", "destination": "/courses", "permanent": true },
    { "source": "/packs", "destination": "/methodology#downloads", "permanent": true },
    { "source": "/packs/:id*", "destination": "/methodology#downloads", "permanent": true },
    { "source": "/research/personalized", "destination": "/research", "permanent": true },
    { "source": "/analyses/warming-and-pacing", "destination": "/analyses/race-day-weather#warming", "permanent": true },
    { "source": "/analyses/wind-and-pacing", "destination": "/analyses/race-day-weather#wind", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Referrer-Policy", "value": "strict-origin" }]
    },
    {
      "source": "/((?!robots\\.txt$).*\\.txt)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/data/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/runners",
      "has": [{ "type": "query", "key": "q" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
